# Variables d'environnement rubinotes — copier vers .env (gitignoré) et adapter.
# En production, TOUTES les valeurs sensibles doivent être définies ici
# (les valeurs par défaut de settings.py ne servent qu'au dev local).

DJANGO_SECRET_KEY=changez-moi-avec-une-vraie-cle-secrete
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Page privée /gouvernance (404 sans mot de passe). À défaut de cette variable,
# le mot de passe est lu dans private/gouv_password (hors dépôt).
GOUV_PASSWORD=
# Dossier des notes .md (hors dépôt). Défaut : <repo>/private/gouvernance
#GOUV_DOCS_DIR=/var/rubicontext/rubinotes/private/gouvernance
